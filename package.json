{
	"name": "@atos-actions/get-playwright-version",
	"description": "Extracts and outputs the Playwright version from a project's lockfile",
	"keywords": [
		"Actions",
		"GitHub",
		"Playwright",
		"Version",
		"Lockfile",
		"CI-CD"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/atos-actions/get-playwright-version.git"
	},
	"bugs": "https://github.com/atos-actions/get-playwright-version/issues",
	"license": "MIT",
	"private": "true",
	"version": "2.0.28",
	"engines": {
		"node": ">= 20.0.0",
		"npm": ">= 10.0.0"
	},
	"files": [
		"action.yml"
	],
	"scripts": {
		"build": "npx ncc build src/index.mjs -o dist --source-map --license licenses.txt",
		"lint": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
		"lint:fix": "biome check --no-errors-on-unmatched --files-ignore-unknown=true --write",
		"release": "npx semantic-release",
		"test": "echo 'No test script defined for this project'"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.0.2",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@vercel/ncc": "^0.45.0",
		"lefthook": "^2.2.3",
		"semantic-release-major-tag": "^0.3.2"
	},
	"optionalDependencies": {
		"semantic-release": "^26.0.1"
	},
	"dependencies": {
		"@actions/core": "^3.0.1",
		"js-yaml": "^5.5.0"
	},
	"allowScripts": {
		"lefthook": true
	}
}
